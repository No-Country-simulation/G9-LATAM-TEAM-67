# TNS_ADMIN es opcional: run-local.ps1 lo configura si encuentra el wallet local.
APP_DB_URL=jdbc:oracle:thin:@database-service
APP_DB_USERNAME=replace-me
APP_DB_PASSWORD=replace-me
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_EXPIRATION=7200000
APP_CLASSIFIER_API_URL=http://classifier-host:8000/predict
CLASSIFIER_CONNECT_TIMEOUT=3000
CLASSIFIER_READ_TIMEOUT=10000
TNS_ADMIN=
